{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/assets/models/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/game",
      "destination": "https://game.omc.network/",
      "permanent": true
    },
    {
      "source": "/game/:path*",
      "destination": "https://game.omc.network/:path*",
      "permanent": true
    },
    {
      "source": "/barbarian-age",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/barbarian-age-play",
      "destination": "/",
      "permanent": true
    }
  ]
}
