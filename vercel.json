{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/assets/models/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "game.omc.network"
        }
      ],
      "destination": "/game",
      "permanent": true
    },
    {
      "source": "/barbarian-age",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/barbarian-age-play",
      "destination": "/",
      "permanent": true
    }
  ]
}
